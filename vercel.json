{
  "version": 2,
  "builds": [
    {"src": "api.js", "use": "@vercel/node"},
    {"src": "index.html", "use": "@vercel/static"},
    {"src": "inventario-icon.jpg", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/offers", "dest": "/api.js"},
    {"src": "/inventario-icon.jpg", "dest": "/inventario-icon.jpg"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
