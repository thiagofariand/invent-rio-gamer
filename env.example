# INVENTÁRIO GAMER Beta1 + Claudinho — EXEMPLO
# Nunca coloque valores reais deste arquivo no GitHub.
# Configure os valores reais em Vercel > Project Settings > Environment Variables.

# OAuth Mercado Livre
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Opcional: altere apenas se o domínio/rota de callback mudar.
MELI_REDIRECT_URI=https://inventario-gamer.vercel.app/api/ml/callback

# Depois de autorizar em /api/ml/connect:
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=

# IGDB / Twitch Developer
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Protege /api/ml/status e /api/igdb/status.
# Crie um valor longo e aleatório somente na Vercel.
DIAGNOSTICS_SECRET=
