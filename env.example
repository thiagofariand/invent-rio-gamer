# INVENTÁRIO GAMER Beta1 + Claudinho — EXEMPLO
# Nunca coloque valores reais deste arquivo no GitHub.
# Configure os valores reais em Vercel > Project Settings > Environment Variables.

# OAuth Mercado Livre
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Opcional: altere apenas se o domínio/rota de callback mudar.
MELI_REDIRECT_URI=https://inventario-gamer.vercel.app/api/ml/callback

# Depois de autorizar em /api/ml/connect:
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=

# IGDB / Twitch Developer
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Protege /api/ml/status e /api/igdb/status.
# Crie um valor longo e aleatório somente na Vercel.
DIAGNOSTICS_SECRET=

# Em alta diário (08:00 de Brasília / 11:00 UTC)
# O YouTube fornece o sinal de popularidade da categoria Gaming no Brasil.
YOUTUBE_API_KEY=
# Opcional: a IA escolhe e resume as 3 franquias entre os sinais encontrados.
# Sem esta chave, o ranking usa somente recorrência, posição e visualizações.
OPENAI_API_KEY=
OPENAI_TRENDS_MODEL=gpt-5
# Protege a chamada automática da Vercel. Use um valor longo e aleatório.
CRON_SECRET=
